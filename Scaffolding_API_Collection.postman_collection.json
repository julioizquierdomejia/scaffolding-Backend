          "name": "GET Scaffolds por radio (1 km)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text",
                "description": "Token de autenticación obtenido del login"
              }
            ],
            "url": {
              "raw": "{{base_url}}/scaffolds?lat=40.7580&lng=-73.9855&radius=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "scaffolds"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "40.7580"
                },
                {
                  "key": "lng",
                  "value": "-73.9855"
                },
                {
                  "key": "radius",
                  "value": "1"
                }
              ]
            },
            "description": "Búsqueda muy cercana - Radio de 1 km"
          },
          "response": []
        },
